#!/usr/bin/env python3
"""Local operator launcher; lifecycle authority stays in the Rust daemon."""
import argparse
import hashlib
import json
import os
import re
from pathlib import Path
import secrets
import signal
import stat
import sqlite3
import subprocess
import sys
import time
from adapter_pins import accepted_pins

REPO = Path(__file__).resolve().parents[1]


def private_read(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('operator configuration must be an owned private regular file')
        data = stream.read(131073)
        if len(data) > 131072:
            raise ValueError('operator configuration exceeds its bound')
        return data.decode()


def write_new(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as stream:
        stream.write(text)


def call(config, state, *args):
    result = subprocess.run([str(Path(config['bin_dir']) / 'conductorctl'), '--socket', str(state / 'control.sock'), '--json', *map(str, args)], capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise ValueError('Conductor refused the request; inspect daemon output and current state')
    return json.loads(result.stdout)['result']['payload']


def stop(process):
    if process.poll() is None:
        process.send_signal(signal.SIGINT)
        process.wait(timeout=20)


def discovery_command(config, args):
    command = ['inspect-workspace', config['project'], '--workspace-root', str(args.workspace_root.expanduser().resolve(strict=True))]
    for name in args.document:
        command.extend(['--document', name])
    return command


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state', type=Path, default=REPO / 'state/operator')
    sub = parser.add_subparsers(dest='command', required=True)
    init = sub.add_parser('init', help='create private operator configuration without model calls')
    init.add_argument('--project', type=Path, required=True)
    init.add_argument('--bin-dir', type=Path, default=REPO / 'target/debug')
    init.add_argument('--port', type=int, default=8787)
    run = sub.add_parser('run', help='run the board and hooks in the foreground')
    run.add_argument('--anthropic-key-file', type=Path, help='read one existing API key into the daemon environment only')
    run.add_argument('--dispatch', action='store_true', help='execute explicitly submitted plans')
    run.add_argument('--recover-fenced', action='store_true')
    backup = sub.add_parser('backup', help='create a verified cold state snapshot; requires stopped and fenced work')
    backup.add_argument('destination', type=Path)
    verify = sub.add_parser('verify-backup', help='verify a cold snapshot without opening the original runtime')
    verify.add_argument('destination', type=Path)
    verify.add_argument('--external', action='store_true', help='also verify recorded external files and directory identities')
    restore = sub.add_parser('restore', help='restore at the original stopped state root and retain current state')
    restore.add_argument('snapshot', type=Path)
    restore.add_argument('--retain-current', type=Path, required=True)
    repair = sub.add_parser('repair-restore', help='repair an interrupted directory publication without launching tasks')
    repair.add_argument('--retained', type=Path, required=True)
    prepare_recovery = sub.add_parser('prepare-recovery', help='quarantine startup and prepare same-host recovery; requires a later host restart')
    prepare_recovery.add_argument('snapshot', type=Path)
    prepare_recovery.add_argument('--retained', type=Path, required=True)
    sub.add_parser('recover-state', help='finish prepared recovery after a verified host restart; never starts tasks')
    sub.add_parser('cancel-recovery', help='cancel preparation before publication staging; never restores or starts work')
    sub.add_parser('status')
    inspect = sub.add_parser('inspect', help='show bounded advisory document references without model calls')
    inspect.add_argument('--workspace-root', type=Path)
    inspect.add_argument('--document', action='append', default=[])
    sub.add_parser('token', help='print the private board token for operator login')
    ctl = sub.add_parser('ctl', help='forward a command to the existing Rust CLI')
    ctl.add_argument('--json', action='store_true')
    ctl.add_argument('arguments', nargs=argparse.REMAINDER)
    rpc = sub.add_parser('rpc', help='send a JSON control request from an account with an operator credential')
    rpc.add_argument('--address', required=True, help='numeric loopback host:port')
    rpc.add_argument('--token-file', type=Path, required=True)
    rpc.add_argument('--request-file', type=Path, help='payload JSON file; defaults to stdin')
    plan = sub.add_parser('plan', help='prepare a plan from previously accepted adapter pins')
    plan.add_argument('--from-plan', type=Path, required=True)
    plan.add_argument('--task', required=True)
    plan.add_argument('--objective-file', type=Path, required=True)
    plan.add_argument('--checks-file', type=Path, required=True)
    plan.add_argument('--depends-on', action='append', default=[])
    plan.add_argument('--input-task')
    plan.add_argument('--decisions-file', type=Path, help='JSON array of initial questions and optional operator rationales')
    plan.add_argument('--instruction', type=Path, action='append', default=[])
    plan.add_argument('--workspace-root', type=Path, help='discover untrusted advisory sources within this explicit ancestor boundary')
    plan.add_argument('--document', action='append', default=[], help='relative candidate path; replaces default discovery names')
    submit = sub.add_parser('submit', help='authorize and queue one prepared native plan')
    submit.add_argument('plan', type=Path)
    submit.add_argument('--on-topic')
    submit.add_argument('--path-prefix')
    args = parser.parse_args()
    os.umask(0o077)
    if args.command == 'rpc':
        from conductor_rpc import send, exit_code
        if args.request_file:
            with args.request_file.open('rb') as stream:
                data = stream.read(1024 * 1024 + 1)
        else:
            data = sys.stdin.buffer.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise ValueError('request exceeds frame limit')
        response = send(args.address, private_read(args.token_file).strip(), json.loads(data))
        print(json.dumps(response, indent=2))
        sys.exit(exit_code(response))
    if args.command == 'verify-backup':
        from operator_backup import verify
        print(json.dumps(verify(args.destination, external=args.external), indent=2))
        return
    state = args.state.expanduser().absolute()
    if args.command == 'run' and (state / 'ARCHIVED_STATE.json').exists():
        raise ValueError('retained archive cannot be started as another dispatcher')
    if args.command in ('run', 'ctl', 'status', 'submit') and len(os.fsencode(state / 'control.sock')) > 100:
        raise ValueError('choose a shorter --state path for the Unix socket')
    if args.command == 'init':
        project = args.project.expanduser().resolve(strict=True)
        subprocess.run(['git', '-C', str(project), 'rev-parse', '--show-toplevel'], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        head = subprocess.run(['git', '-C', str(project), 'rev-parse', '--verify', 'HEAD'], capture_output=True)
        if head.returncode:
            raise ValueError('project needs an existing Git commit before observation and snapshots')
        bins = args.bin_dir.resolve(strict=True)
        for name in ['conductor-daemon', 'conductorctl', 'conductor-runner']:
            if not os.access(bins / name, os.X_OK):
                raise ValueError('build the Rust workspace before initialization')
        if not 1024 <= args.port <= 65535:
            raise ValueError('board port must be between 1024 and 65535')
        state.mkdir(mode=0o700, parents=True, exist_ok=False)
        state = state.resolve(strict=True)
        config = dict(project=str(project), project_id='operator-project', bin_dir=str(bins), port=args.port)
        write_new(state / 'operator.json', json.dumps(config, indent=2) + '\n')
        write_new(state / 'board-token', secrets.token_urlsafe(32) + '\n')
        (state / 'plans').mkdir(mode=0o700)
        (state / 'artifacts').mkdir(mode=0o700)
        print(f'Initialized {state}\nRun tools/conductor --state {state} run --dispatch')
        return
    if args.command in ('prepare-recovery', 'recover-state', 'cancel-recovery'):
        import disaster_recovery
        if args.command == 'prepare-recovery':
            result = disaster_recovery.prepare(state, args.snapshot, args.retained)
        elif args.command == 'recover-state':
            result = disaster_recovery.finish(state)
        else:
            result = disaster_recovery.cancel(state)
        print(json.dumps(result, indent=2))
        return
    if args.command == 'repair-restore':
        from restore_publication import repair
        print(json.dumps(repair(state, args.retained), indent=2))
        return
    state = state.resolve(strict=True)
    if state.stat().st_mode & 0o077 or state.stat().st_uid != os.getuid():
        raise ValueError('state directory must be private and owned by the operator')
    if args.command == 'restore':
        from operator_restore import restore
        print(json.dumps(restore(state, args.snapshot, args.retain_current), indent=2))
        return
    config = json.loads(private_read(state / 'operator.json'))
    if args.command == 'backup':
        from operator_backup import backup
        print(json.dumps(backup(state, args.destination), indent=2))
    elif args.command == 'token':
        print(private_read(state / 'board-token').strip())
    elif args.command == 'ctl':
        forwarded = args.arguments[1:] if args.arguments[:1] == ['--'] else args.arguments
        os.execv(str(Path(config['bin_dir']) / 'conductorctl'), ['conductorctl', '--socket', str(state / 'control.sock'), *(['--json'] if args.json else []), *forwarded])
    elif args.command == 'inspect':
        command = discovery_command(config, args) if args.workspace_root else ['inspect-project', config['project']]
        if args.document and not args.workspace_root:
            raise ValueError('--document requires --workspace-root')
        os.execv(str(Path(config['bin_dir']) / 'conductorctl'), ['conductorctl', *command])
    elif args.command == 'status':
        print(json.dumps(dict(health=call(config, state, 'health'), tasks=call(config, state, 'list-tasks'), workflows=call(config, state, 'list-workflows')), indent=2))
    elif args.command == 'plan':
        if not args.task or len(args.task) > 100 or any(c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_' for c in args.task):
            raise ValueError('task ID must use 1-100 letters, digits, underscores or hyphens')
        template = json.loads(args.from_plan.read_text())
        value = {key: template[key] for key in ('worker', 'verifier', 'model_timeout_ms')}
        value.update(accepted_pins(template))
        value.update(task_id=args.task, project=config['project'], objective=args.objective_file.read_text(), artifacts=str(state / 'artifacts' / args.task), wrapper=str(Path(config['bin_dir']) / 'conductor-runner'), checks=json.loads(args.checks_file.read_text()), toolchain_roots=template.get('toolchain_roots', []), instructions=[])
        if template.get('full_capability') is not None:
            value['full_capability'] = template['full_capability']
        if template.get('account_worker') is not None:
            value['account_worker'] = template['account_worker']
        if args.document and not args.workspace_root:
            raise ValueError('--document requires --workspace-root')
        if args.workspace_root:
            discovered = subprocess.run([str(Path(config['bin_dir']) / 'conductorctl'), *discovery_command(config, args)], capture_output=True, text=True, timeout=15, check=True)
            sources = json.loads(discovered.stdout)['documents']
            if sources:
                value['advisory_sources'] = sources
        if args.decisions_file:
            value['decisions'] = json.loads(args.decisions_file.read_text())
        if args.depends_on:
            value['depends_on'] = args.depends_on
        if args.input_task:
            if args.input_task not in args.depends_on:
                raise ValueError('--input-task requires a matching --depends-on')
            value['input_task'] = args.input_task
        for source in args.instruction:
            source = source.resolve(strict=True)
            value['instructions'].append(dict(path=str(source), sha256=hashlib.sha256(source.read_bytes()).hexdigest()))
        output = state / 'plans' / (args.task + '.json')
        write_new(output, json.dumps(value, indent=2) + '\n')
        print(output)
    elif args.command == 'submit':
        value = json.loads(args.plan.read_text())
        if value['project'] != config['project']:
            raise ValueError('plan project differs from this operator runtime')
        if args.path_prefix and not args.on_topic:
            raise ValueError('--path-prefix requires --on-topic')
        if args.on_topic:
            worker = value['task_id'] + ':worker'
            pin = value['worker']
            call(config, state, 'register-agent', 'operator', worker + ':register', worker, pin['kind'], pin['conformance_sha256'], pin['executable_sha256'], 'read_write')
            subscription = value['task_id'] + ':input'
            call(config, state, 'subscribe-events', json.dumps(dict(schema_version=1, id=subscription, agent_id=worker, topic_filter=args.on_topic, project_id=config['project_id'], path_prefix=args.path_prefix, echo_source=False)))
            value['wake_subscription'] = subscription
            target = state / 'plans' / (hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest() + '.submitted.json')
            if not target.exists():
                write_new(target, json.dumps(value, indent=2))
        else:
            target = args.plan.resolve(strict=True)
        print(json.dumps(call(config, state, 'submit-workflow', target), indent=2))
    elif args.command == 'run':
        if (state / 'ARCHIVED_STATE.json').exists():
            raise ValueError('retained archive cannot be started as another dispatcher')
        if args.recover_fenced and not args.dispatch:
            raise ValueError('--recover-fenced requires --dispatch')
        daemon = str(Path(config['bin_dir']) / 'conductor-daemon')
        common = [daemon, '--database', str(state / 'state.sqlite3'), '--socket', str(state / 'control.sock'), '--lock', str(state / 'runtime.lock')]
        try:
            call(config, state, 'health')
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
        else:
            raise ValueError('this operator runtime is already running')
        bootstrap = subprocess.Popen(common)
        try:
            for _ in range(100):
                if bootstrap.poll() is not None:
                    raise ValueError('bootstrap daemon exited; another owner may already be running')
                try:
                    call(config, state, 'health')
                    break
                except (OSError, ValueError, subprocess.TimeoutExpired):
                    time.sleep(.1)
            else:
                raise ValueError('daemon readiness deadline')
            call(config, state, 'register-project', 'operator', 'operator-project:register', config['project_id'], config['project'])
            call(config, state, 'register-agent', 'operator', 'operator-observer:register', 'operator-observer', 'hook', 'hook-v1', 'read-only', 'read_only')
        finally:
            stop(bootstrap)
        watch = state / 'watches.json'
        expected = json.dumps([dict(id='operator-watch', project_id=config['project_id'], source_agent_id='operator-observer', root=config['project'])])
        if not watch.exists():
            write_new(watch, expected)
        elif private_read(watch) != expected:
            raise ValueError('watch configuration changed; inspect it before restarting')
        if args.anthropic_key_file:
            key_text = private_read(args.anthropic_key_file.expanduser().resolve(strict=True))
            matches = re.findall(r'sk' r'-ant-[A-Za-z0-9_-]+', key_text)
            if len(matches) != 1:
                raise ValueError('key file must contain exactly one Anthropic API key')
            os.environ['ANTHROPIC_API_KEY'] = matches[0]
            del key_text, matches
        os.environ['CONDUCTOR_OPERATOR_TOKEN'] = private_read(state / 'board-token').strip()
        argv = common + ['--watch-config', str(watch), '--http', f"127.0.0.1:{config['port']}"]
        if args.dispatch:
            argv.append('--dispatch')
        if args.recover_fenced:
            argv.append('--recover-fenced')
        print(f"Board: http://127.0.0.1:{config['port']}\nUse the token command in another terminal to log in. Ctrl-C stops this runtime.", flush=True)
        os.execv(daemon, argv)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (ValueError, OSError, sqlite3.Error, subprocess.SubprocessError, KeyError, json.JSONDecodeError) as error:
        print(f'Operator launcher failed: {type(error).__name__}; {error}', file=sys.stderr)
        sys.exit(1)
